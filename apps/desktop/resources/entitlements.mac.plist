<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Cello.app's entitlements when it's signed with the hardened runtime (package.ts's sign flag, CEL-139;
     unsigned builds don't use this file). Electron's V8 and the bundled cello (a Bun executable at
     Contents/Resources/cello) both compile JavaScript at run time, which the hardened runtime blocks without
     the JIT entitlements; Bun's docs on signing compiled executables list the rest. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
