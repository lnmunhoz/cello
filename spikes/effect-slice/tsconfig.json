{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "jsx": "react-jsx", "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["bun"],
    "skipLibCheck": true, "exactOptionalPropertyTypes": false
  },
  "include": ["src", "web"]
}
